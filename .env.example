# Database
DATABASE_URL=postgresql+asyncpg://yata:yata@localhost:5432/yata

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-here

# Environment
ENVIRONMENT=local

# LLM opt-in (yata-0018): leave unset for the local fake (no paid API call,
# no AWS credentials needed). Set to "bedrock" only to reach the real
# Amazon Bedrock model; production sets this in docker-compose.prod.yml.
# YATA_LLM=bedrock
